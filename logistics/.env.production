# Production build values for Veloxa.
#
# Both are NEXT_PUBLIC_*, which Next.js inlines into the JavaScript it serves to
# browsers — they are public by definition and hold no secret. Keeping them here
# rather than in the Vercel dashboard makes the deploy reproducible from a clean
# checkout. Anything genuinely secret must NOT live in this file.

# The PocketBase instance shared with the Xperience Delivery store.
NEXT_PUBLIC_PB_URL=https://35.223.37.187.sslip.io

# Canonical public URL of this site — update when the veloxa domain is attached.
NEXT_PUBLIC_SITE_URL=https://veloxa-logistics.vercel.app
