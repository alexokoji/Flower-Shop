# PocketBase URL (no trailing slash). Default: http://localhost:8090
NEXT_PUBLIC_PB_URL=http://localhost:8090

NEXT_PUBLIC_APP_NAME="Xperience Delivery"
NEXT_PUBLIC_BASE_CURRENCY=USD
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Payments (publishable / public keys only — never put secrets here)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
NEXT_PUBLIC_MONNIFY_API_KEY=
NEXT_PUBLIC_MONNIFY_CONTRACT_CODE=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Veloxa Logistics tracking site (own domain)
NEXT_PUBLIC_LOGISTICS_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# MongoDB (server-side only — NEVER prefix these NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Replace <db_password> with the real Atlas password for the admin-user account.
MONGODB_URI=mongodb+srv://admin-user:<db_password>@cluster0.rpildmg.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=xperience

# Signs session cookies. Generated for this machine; use a DIFFERENT value in
# production and treat it like a password — changing it signs everyone out.
AUTH_SECRET=generate-with-openssl-rand-hex-32

# Used to build password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
